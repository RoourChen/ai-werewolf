# Copy this file to `.env` and fill in your credentials.
# `.env` is git-ignored — never commit real keys.

# Provider preset (openai | deepseek | mimo | groq | openrouter)
AIWEREWOLF_PROVIDER=deepseek

# ...or set a custom endpoint directly (overrides AIWEREWOLF_PROVIDER):
# AIWEREWOLF_BASE_URL=https://api.deepseek.com

# Your API key. It is read ONLY from this environment variable.
# Never put it in code, tests, logs, exceptions, replays or Git.
AIWEREWOLF_API_KEY=

# Model id. Use deepseek-v4-flash (deepseek-chat is deprecated).
AIWEREWOLF_MODEL=deepseek-v4-flash

# Optional generation settings.
# AIWEREWOLF_TEMPERATURE=0.8
# AIWEREWOLF_MAX_TOKENS=600
# AIWEREWOLF_TIMEOUT=20        # hard timeout per call (seconds)
# AIWEREWOLF_JSON_MODE=1       # enable JSON Object output (default on)
# AIWEREWOLF_THINKING=0        # non-thinking mode (default off)
